# Waitlist (Brevo) — configurar en Netlify › Site settings › Environment variables.
# Obtén la API key en: https://app.brevo.com › SMTP & API › API Keys
BREVO_API_KEY=

# Opcional: ID numérico de la lista de Brevo donde se inscriben los correos.
# Si se omite, el contacto se crea sin lista asignada.
BREVO_LIST_ID=

# Opcional (Formulario de Contacto): Correo electrónico del remitente para envíos SMTP.
# DEBE ser un dominio o remitente verificado en Brevo (Sender). Por defecto: no-reply@edav.com.co
BREVO_SENDER_EMAIL=
